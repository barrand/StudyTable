{
  "name": "study-table",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "overrides": { "postcss": "8.5.31" },
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts tests/*.test.tsx",
    "import:corpus": "tsx scripts/import-corpus.ts",
    "verify:corpus": "tsx scripts/import-corpus.ts --verify",
    "import:words": "tsx scripts/import-words.ts",
    "verify:words": "tsx scripts/import-words.ts --verify"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "@types/jsdom": "30.0.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  }
}
